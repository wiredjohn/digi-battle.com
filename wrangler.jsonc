{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digi-battle-com",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
